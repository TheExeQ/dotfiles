{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "deny"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "write": "allow",
        "edit": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "write": "deny",
        "edit": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permission": {
        "write": "deny",
        "edit": "deny"
      }
    }
  }
}
